# ─── Application ───────────────────────────────────────────────
APP_NAME=AI Trading Analyst
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ─── Database ──────────────────────────────────────────────────
# SQLite (default for local dev — zero setup required)
DATABASE_URL=sqlite+aiosqlite:///./trading_analyst.db
# PostgreSQL (for production — uncomment and fill)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_analyst

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500

# ─── NewsAPI ───────────────────────────────────────────────────
NEWS_API_KEY=your-newsapi-key-here
NEWS_ENABLED=true

# ─── Market Data ───────────────────────────────────────────────
MARKET_DATA_CACHE_TTL=300
SCANNER_BATCH_SIZE=10
SCANNER_MAX_WORKERS=4
DEFAULT_LOOKBACK_DAYS=365

# ─── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ─── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=8501
